# Copy to .dev.vars (gitignored) for `npm run dev`. Names only; never commit values.
# Generate the VAPID pair with `npm run gen-vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: mailto: or https: contact sent to push services (defaults to the app URL).
VAPID_SUBJECT=
# Cron worker only: shared secret for POST /run?force=1 (header X-Job-Trigger-Key).
JOB_TRIGGER_KEY=
# Optional: base URL for personal links (defaults to the request origin).
APP_BASE_URL=
# Live ChMS connection (OAuth).
CHMS_CLIENT_ID=
CHMS_CLIENT_SECRET=
# Encrypts the Pushpay tokens in D1 (AES-256-GCM). 32 random bytes, base64url: `npm run gen-token-key`.
# Required when dataSource is "pushpay"; Pages and the cron worker must share the same value.
TOKEN_ENC_KEY=
# Pages only: /oauth/start?key=<this>. Remove or rotate it once the Master Admin has approved.
OAUTH_SETUP_KEY=
