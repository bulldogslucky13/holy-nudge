{
  "name": "holy-nudge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Holy Nudge: daily web-push nudges for Wildwood college ministry leaders",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler pages dev",
    "dev:cron": "wrangler dev -c cron-worker/wrangler.toml --test-scheduled --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply holy-nudge --local",
    "db:migrate:remote": "wrangler d1 migrations apply holy-nudge --remote",
    "deploy": "wrangler pages deploy",
    "deploy:cron": "wrangler deploy -c cron-worker/wrangler.toml",
    "gen-vapid": "node scripts/gen-vapid.mjs",
    "add-leader": "node scripts/add-leader.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
